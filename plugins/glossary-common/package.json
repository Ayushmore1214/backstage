{
  "name": "@backstage/plugin-glossary-common",
  "version": "0.1.0",
  "description": "Common functionalities for the glossary plugin",
  "backstage": {
    "role": "common-library",
    "pluginId": "glossary",
    "pluginPackages": [
      "@backstage/plugin-glossary",
      "@backstage/plugin-glossary-backend",
      "@backstage/plugin-glossary-common"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage"
  ],
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "plugins/glossary-common"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/catalog-model": "workspace:^"
  },
  "devDependencies": {
    "@backstage/cli": "workspace:^"
  }
}